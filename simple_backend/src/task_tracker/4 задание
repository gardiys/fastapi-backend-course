import requests
from abc import ABC, abstractmethod
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import List
from enum import Enum
from itertools import count

# ===== БАЗОВЫЙ HTTP-КЛИЕНТ =====
class BaseHTTPClient(ABC):
    """Абстрактный HTTP-клиент с общими методами"""
    
    BASE_URL: str
    HEADERS: dict

    @abstractmethod
    def send_request(self, endpoint: str, data: dict) -> dict:
        """Абстрактный метод для отправки запроса"""
        pass

# ===== КЛИЕНТ ДЛЯ РАБОТЫ С CLOUDFLARE AI =====
class CloudflareAIClient(BaseHTTPClient):
    """Клиент для взаимодействия с Cloudflare Workers AI"""

    BASE_URL = "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run"
    HEADERS = {
        "Authorization": f"Bearer YOUR_CLOUDFLARE_API_KEY",
        "Content-Type": "application/json"
    }

    def send_request(self, endpoint: str, data: dict) -> dict:
        """Отправляет запрос к Cloudflare AI"""
        response = requests.post(f"{self.BASE_URL}{endpoint}", json=data, headers=self.HEADERS)
        return response.json() if response.status_code == 200 else {"error": "Ошибка при запросе"}

    def get_solution(self, task_text: str) -> str:
        """Запрашивает у AI способы решения задачи"""
        data = {
            "model": "mistral/mistral-7b-instruct-v0.1",
            "prompt": f"Как решить следующую задачу?\n{task_text}",
            "max_tokens": 200
        }
        result = self.send_request("", data)
        return result.get("result", "Ответ не получен")


# ===== API для управления задачами =====
app = FastAPI()
cloudflare_ai = CloudflareAIClient()

class TaskStatus(str, Enum):
    pending = "pending"
    in_progress = "in_progress"
    completed = "completed"

class Task(BaseModel):
    id: int
    title: str
    status: TaskStatus
    description: str

task_counter = count(1)
tasks = []

@app.get("/tasks", response_model=List[Task])
def get_tasks():
    return tasks

@app.post("/tasks", response_model=Task)
def create_task(task: Task):
    task.id = next(task_counter)
    
    # Запрос к Cloudflare AI
    solution = cloudflare_ai.get_solution(task.description)
    
    # Добавляем ответ AI в описание задачи
    task.description += f"\n\nAI Solution:\n{solution}"
    
    tasks.append(task)
    return task

@app.put("/tasks/{task_id}", response_model=Task)
def update_task(task_id: int, updated_task: Task):
    for i, task in enumerate(tasks):
        if task.id == task_id:
            tasks[i] = updated_task
            return updated_task
    raise HTTPException(status_code=404, detail="Task not found")

@app.delete("/tasks/{task_id}")
def delete_task(task_id: int):
    for i, task in enumerate(tasks):
        if task.id == task_id:
            tasks.pop(i)
            return {"message": "Task deleted"}
    raise HTTPException(status_code=404, detail="Task not found")
